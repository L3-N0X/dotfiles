#!/usr/bin/env python3
"""Position, zoom and rotate Hyprland displays by editing monitor_layout.lua.

Every change is written to the layout file *and* applied to the running
compositor, so it survives a reload without one being needed.

The compositor is driven through `hyprctl eval` rather than `hyprctl keyword`:
this config is Lua, and keyword only speaks to the legacy parser.
"""

import argparse
import json
import os
import re
import subprocess
import sys

LAYOUT_PATH = os.path.expanduser(
    os.environ.get("MONITORCTL_LAYOUT", "~/.config/hypr/mainconf/monitor_layout.lua")
)

SIDES = ("left", "right", "up", "down")
AUTO_POSITION = {
    "left": "auto-left",
    "right": "auto-right",
    "up": "auto-up",
    "down": "auto-down",
}
TRANSFORMS = {
    "normal": 0, "0": 0,
    "90": 1, "1": 1,
    "180": 2, "2": 2,
    "270": 3, "3": 3,
}
MIN_ZOOM, MAX_ZOOM = 0.5, 3.0


class Fail(Exception):
    pass


# --- reading and writing the layout file ------------------------------------

def read_layout():
    """Evaluate the layout file with real Lua so hand edits parse exactly."""
    probe = (
        'local ok, t = pcall(dofile, os.getenv("MONITORCTL_LAYOUT_PATH"))\n'
        'if not ok then io.stderr:write(tostring(t)) os.exit(1) end\n'
        'if type(t) ~= "table" then io.stderr:write("layout did not return a table") os.exit(1) end\n'
        'print("anchor\\t\\t" .. tostring(t.anchor or ""))\n'
        'for _, name in ipairs({"side", "zoom", "transform"}) do\n'
        '  for k, v in pairs(t[name] or {}) do print(name .. "\\t" .. k .. "\\t" .. tostring(v)) end\n'
        'end\n'
    )
    try:
        out = subprocess.run(
            ["lua", "-e", probe],
            capture_output=True, text=True, check=True,
            env={**os.environ, "MONITORCTL_LAYOUT_PATH": LAYOUT_PATH},
        ).stdout
    except FileNotFoundError:
        raise Fail("the `lua` interpreter is required to read the layout file")
    except subprocess.CalledProcessError as e:
        raise Fail(f"could not read {LAYOUT_PATH}: {e.stderr.strip()}")

    layout = {"anchor": "", "side": {}, "zoom": {}, "transform": {}}
    for line in out.splitlines():
        if not line.strip():
            continue
        table, key, value = line.split("\t", 2)
        if table == "anchor":
            layout["anchor"] = value
        elif table == "side":
            layout["side"][key] = value
        else:
            layout[table][key] = float(value)
    return layout


def _lua_value(value):
    if isinstance(value, str):
        return '"%s"' % value.replace("\\", "\\\\").replace('"', '\\"')
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return repr(value)


def _replace_table(src, name, entries):
    """Rewrite the body of `name = { ... }`, leaving surrounding comments alone."""
    opener = re.search(r"(^[ \t]*)%s(\s*)=(\s*)\{" % re.escape(name), src, re.M)
    if not opener:
        raise Fail(f"could not find the `{name}` table in {LAYOUT_PATH}")

    depth, i = 1, opener.end()
    while i < len(src) and depth:
        if src[i] == "{":
            depth += 1
        elif src[i] == "}":
            depth -= 1
        i += 1
    if depth:
        raise Fail(f"the `{name}` table in {LAYOUT_PATH} is not closed")

    indent = opener.group(1) + "    "
    if not entries:
        body = ""
    else:
        keys = ["[%s]" % _lua_value(k) for k in entries]
        width = max(len(k) for k in keys)
        body = "\n" + "".join(
            "%s%-*s = %s,\n" % (indent, width, key, _lua_value(entries[k]))
            for key, k in zip(keys, entries)
        ) + opener.group(1)
    return src[:opener.end()] + body + src[i - 1:]


def write_layout(layout):
    with open(LAYOUT_PATH) as fh:
        src = fh.read()

    src = re.sub(
        r"(^[ \t]*anchor\s*=\s*)(\"[^\"]*\"|'[^']*')",
        lambda m: m.group(1) + _lua_value(layout["anchor"]),
        src, count=1, flags=re.M,
    )
    for name in ("side", "zoom", "transform"):
        entries = dict(sorted(layout[name].items()))
        src = _replace_table(src, name, entries)

    tmp = LAYOUT_PATH + ".monitorctl.tmp"
    with open(tmp, "w") as fh:
        fh.write(src)
    os.replace(tmp, LAYOUT_PATH)


# --- talking to Hyprland ----------------------------------------------------

def hyprctl_monitors():
    try:
        out = subprocess.run(
            ["hyprctl", "-j", "monitors", "all"], capture_output=True, text=True, check=True
        ).stdout
    except (FileNotFoundError, subprocess.CalledProcessError):
        raise Fail("could not reach Hyprland via hyprctl")
    return [m for m in json.loads(out) if not m.get("disabled")]


def hypr_eval(code):
    result = subprocess.run(
        ["hyprctl", "eval", code], capture_output=True, text=True
    )
    reply = (result.stdout or result.stderr).strip()
    if result.returncode != 0 or reply not in ("ok", ""):
        raise Fail(f"Hyprland rejected the layout: {reply}")


# --- identifying monitors ---------------------------------------------------

def key_matches(key, monitor):
    if key.startswith("desc:"):
        return monitor.get("description", "").startswith(key[5:])
    return key == monitor["name"]


def layout_key(monitor, layout):
    """The layout-file key for a live monitor, reusing an existing one if any."""
    known = [layout["anchor"]] + list(layout["side"]) + list(layout["zoom"]) + list(layout["transform"])
    for key in known:
        if key and key_matches(key, monitor):
            return key
    description = monitor.get("description", "").strip()
    return "desc:" + description if description else monitor["name"]


def resolve(target, monitors, layout):
    """Find one live monitor from a name, a description fragment, or an alias."""
    if not target or target in ("focused", "active", "current"):
        for m in monitors:
            if m.get("focused"):
                return m
        raise Fail("no focused monitor")
    if target in ("anchor", "laptop"):
        target = layout["anchor"]

    needle = target.lower()
    if needle.startswith("desc:"):
        needle = needle[5:]

    exact = [m for m in monitors if m["name"].lower() == needle]
    if exact:
        return exact[0]
    fuzzy = [m for m in monitors if needle in m.get("description", "").lower()]
    if len(fuzzy) == 1:
        return fuzzy[0]
    if len(fuzzy) > 1:
        names = ", ".join("%s (%s)" % (m["name"], m["description"]) for m in fuzzy)
        raise Fail(f"'{target}' matches several monitors: {names}")
    known = ", ".join("%s (%s)" % (m["name"], m.get("description", "")) for m in monitors)
    raise Fail(f"no connected monitor matches '{target}'. Connected: {known}")


# --- zoom -------------------------------------------------------------------

def snap_zoom(monitor, requested):
    """Nearest zoom Hyprland will actually accept.

    Hyprland quantises scale to a 1/120 grid and rejects any value that leaves
    fractional logical pixels, silently substituting the nearest one that works.
    Do that same search here, so the number written to the layout file is the
    number the compositor ends up using instead of one it will quietly replace.
    """
    requested = max(MIN_ZOOM, min(MAX_ZOOM, requested))
    width, height = monitor["width"], monitor["height"]
    best = None
    for step in range(round(MIN_ZOOM * 120), round(MAX_ZOOM * 120) + 1):
        # scale = step / 120, so the logical size is width * 120 / step. Testing
        # divisibility in integers keeps this exact.
        if (width * 120) % step or (height * 120) % step:
            continue
        distance = abs(step / 120 - requested)
        if best is None or distance < best[0]:
            best = (distance, step / 120)
    if best is None:
        raise Fail(f"no usable zoom near {requested} for {monitor['name']}")
    return round(best[1], 6)


def parse_zoom(value, current, monitor):
    value = value.strip()
    try:
        if value.startswith(("+", "-")):
            return snap_zoom(monitor, current + float(value))
        return snap_zoom(monitor, float(value))
    except ValueError:
        raise Fail(f"'{value}' is not a zoom level (try 1.25, +0.25 or -0.25)")


# --- applying ---------------------------------------------------------------

def apply_layout(layout, monitors):
    """Push the layout to the compositor, anchor first.

    The anchor is pinned to the origin and everything else uses `auto-*`, which
    is exactly what monitors.lua does at startup -- so the live result and the
    result after a reload are the same.
    """
    ordered = sorted(monitors, key=lambda m: not key_matches(layout["anchor"], m))
    for monitor in ordered:
        key = layout_key(monitor, layout)
        is_anchor = key_matches(layout["anchor"], monitor)
        position = "0x0" if is_anchor else AUTO_POSITION.get(layout["side"].get(key), "auto-right")
        hypr_eval(
            'hl.monitor({{ output = "{output}", mode = "{w}x{h}@{hz:.2f}", '
            'position = "{position}", scale = {scale}, transform = {transform} }})'.format(
                output=monitor["name"],
                w=monitor["width"],
                h=monitor["height"],
                hz=monitor["refreshRate"],
                position=position,
                scale=layout["zoom"].get(key, 1),
                transform=int(layout["transform"].get(key, 0)),
            )
        )


def describe(monitors, layout):
    rows = []
    for monitor in sorted(monitors, key=lambda m: m["x"]):
        key = layout_key(monitor, layout)
        is_anchor = key_matches(layout["anchor"], monitor)
        rows.append({
            "name": monitor["name"],
            "description": monitor.get("description", ""),
            "key": key,
            "anchor": is_anchor,
            "side": "anchor" if is_anchor else layout["side"].get(key, "right"),
            "zoom": layout["zoom"].get(key, monitor["scale"]),
            "transform": int(layout["transform"].get(key, monitor["transform"])),
            "resolution": "%dx%d@%.2f" % (monitor["width"], monitor["height"], monitor["refreshRate"]),
            "position": "%dx%d" % (monitor["x"], monitor["y"]),
            "focused": bool(monitor.get("focused")),
        })
    return rows


# --- commands ---------------------------------------------------------------

def cmd_list(args):
    layout = read_layout()
    rows = describe(hyprctl_monitors(), layout)
    if args.json:
        print(json.dumps({"anchor": layout["anchor"], "monitors": rows}, indent=2))
        return
    for row in rows:
        flags = " *focused*" if row["focused"] else ""
        print("%-10s %-38s %-7s zoom %-6s %s%s" % (
            row["name"], row["description"] or "-", row["side"],
            row["zoom"], row["resolution"], flags,
        ))


def _commit(layout, message):
    write_layout(layout)
    apply_layout(layout, hyprctl_monitors())
    print(message)


def cmd_side(args):
    layout = read_layout()
    monitors = hyprctl_monitors()
    monitor = resolve(args.monitor, monitors, layout)
    key = layout_key(monitor, layout)
    if key_matches(layout["anchor"], monitor):
        raise Fail(f"{monitor['name']} is the anchor; move another display instead, "
                   f"or re-anchor with `monitorctl anchor`")
    layout["side"][key] = args.side
    _commit(layout, f"{monitor['name']} is now {args.side} of {layout['anchor']}")


def cmd_swap(args):
    layout = read_layout()
    monitors = hyprctl_monitors()
    if args.monitor:
        monitor = resolve(args.monitor, monitors, layout)
    else:
        others = [m for m in monitors if not key_matches(layout["anchor"], m)]
        if len(others) != 1:
            raise Fail("name a monitor to swap -- there is not exactly one external display")
        monitor = others[0]

    key = layout_key(monitor, layout)
    opposite = {"left": "right", "right": "left", "up": "down", "down": "up"}
    current = layout["side"].get(key, "right")
    layout["side"][key] = opposite[current]
    _commit(layout, f"{monitor['name']} moved from the {current} to the {layout['side'][key]}")


def cmd_zoom(args):
    layout = read_layout()
    monitors = hyprctl_monitors()
    monitor = resolve(args.monitor, monitors, layout)
    key = layout_key(monitor, layout)
    current = layout["zoom"].get(key, monitor["scale"])
    zoom = parse_zoom(args.level, current, monitor)
    layout["zoom"][key] = zoom
    logical = "%dx%d" % (round(monitor["width"] / zoom), round(monitor["height"] / zoom))
    _commit(layout, f"{monitor['name']} zoom {current} -> {zoom} ({logical} logical)")


def cmd_rotate(args):
    layout = read_layout()
    monitors = hyprctl_monitors()
    monitor = resolve(args.monitor, monitors, layout)
    key = layout_key(monitor, layout)
    if args.rotation not in TRANSFORMS:
        raise Fail(f"'{args.rotation}' is not a rotation (normal, 90, 180, 270)")
    layout["transform"][key] = TRANSFORMS[args.rotation]
    _commit(layout, f"{monitor['name']} rotated to {args.rotation}")


def cmd_anchor(args):
    layout = read_layout()
    monitors = hyprctl_monitors()
    monitor = resolve(args.monitor, monitors, layout)
    key = layout_key(monitor, layout)
    layout["anchor"] = key
    layout["side"].pop(key, None)
    _commit(layout, f"{monitor['name']} is now the anchor")


def cmd_apply(args):
    layout = read_layout()
    if args.reload:
        subprocess.run(["hyprctl", "reload"], check=False)
        print("reloaded Hyprland")
        return
    apply_layout(layout, hyprctl_monitors())
    print("layout applied")


def main():
    parser = argparse.ArgumentParser(
        prog="monitorctl",
        description="Position, zoom and rotate Hyprland displays.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="show every connected display")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("side", help="place a display relative to the anchor")
    p.add_argument("monitor")
    p.add_argument("side", choices=SIDES)
    p.set_defaults(func=cmd_side)

    p = sub.add_parser("swap", help="flip a display to the opposite side")
    p.add_argument("monitor", nargs="?")
    p.set_defaults(func=cmd_swap)

    p = sub.add_parser("zoom", help="set zoom, absolutely (1.25) or relatively (+0.25)")
    p.add_argument("monitor")
    p.add_argument("level")
    p.set_defaults(func=cmd_zoom)

    p = sub.add_parser("rotate", help="rotate a display")
    p.add_argument("monitor")
    p.add_argument("rotation")
    p.set_defaults(func=cmd_rotate)

    p = sub.add_parser("anchor", help="make a display the one others are placed around")
    p.add_argument("monitor")
    p.set_defaults(func=cmd_anchor)

    p = sub.add_parser("apply", help="re-apply the saved layout")
    p.add_argument("--reload", action="store_true", help="reload the whole config instead")
    p.set_defaults(func=cmd_apply)

    args = parser.parse_args()
    try:
        args.func(args)
    except Fail as e:
        print(f"monitorctl: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
